{
  "package": {
    "productName": "열린 족보이야기",
    "version": "1.1.1"
  },
  "build": {
    "distDir": "../dist",
    "devPath": "../dist",
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "withGlobalTauri": true
  },
  "tauri": {
    "allowlist": {
      "shell": {
        "open": true
      },
      "dialog": {
        "all": true,
        "ask": true,
        "confirm": true,
        "message": true,
        "open": true,
        "save": true
      },
      "window": {
        "all": true
      },
      "fs": {
        "all": true,
        "scope": [
          "$DOCUMENT",
          "$DOCUMENT/*",
          "$DOCUMENT/**",
          "$DESKTOP",
          "$DESKTOP/*",
          "$DESKTOP/**",
          "$DOWNLOAD",
          "$DOWNLOAD/*",
          "$DOWNLOAD/**",
          "$APPDATA",
          "$APPDATA/*",
          "$APPDATA/**",
          "$HOME/**",
          "$HOME/Library/Mobile Documents/iCloud~md~obsidian/Documents/**",
          "/Users/sanghyunkim/Library/Mobile Documents/iCloud~md~obsidian/Documents/**"
        ]
      },
      "path": {
        "all": true
      }
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://f.jubilee.or.kr/update.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZEQ0ExNTFGOTcyQzRDN0YKUldSL1RDeVhIeFhLYmNzVmdnMGZqUjM3Q090aWNlaTd1aDVzZFIySCtPSFIvMnJzam5HYldxWXgK"
    },
    "bundle": {
      "active": true,
      "targets": ["app", "updater"],
      "identifier": "com.bible.genealogy",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "category": "public.app-category.reference"
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "열린 족보이야기",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}